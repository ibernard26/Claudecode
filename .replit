modules = ["nodejs-20:v8-20231227-322e88b"]

[nix]
channel = "stable-24_05"

# Only the Vite dev server is public-facing.
# The API server runs internally on 3001; the Vite proxy forwards /api/* to it.
[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web"

# ── API Server ─────────────────────────────────────────────────────────────
[[workflows.workflow]]
name = "API Server"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --frozen-lockfile=false"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run push-force"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && PORT=3001 node --enable-source-maps ./dist/index.js"
waitForPort = 3001

# ── Vite Dev Server ────────────────────────────────────────────────────────
[[workflows.workflow]]
name = "web"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/warehouse-hub && PORT=5000 BASE_PATH=/ pnpm run dev"
waitForPort = 5000
