.env.example

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-REPLACE_ME
ANTHROPIC_MODEL=claude-2.1

# Bing search (optional)
BING_API_KEY=

# Whisper.cpp local STT (set paths if you installed whisper.cpp)
WHISPER_CPP_PATH=/path/to/whisper.cpp/main  # path to whisper.cpp executable (Linux binary recommended)
WHISPER_MODEL_PATH=/path/to/ggml-model.bin  # model file path (ggml model)

# Coqui TTS (CLI) - optional. If not using, set COQUI_TTS_CLI=false and browser TTS will be used.
COQUI_TTS_CLI=true
COQUI_TTS_CMD=tts  # CLI command for Coqui TTS (e.g. `tts --text "hello" --out_path out.wav`)

# Server
PORT=5000

# TTS output format
TTS_FORMAT=mp3

# Other
NODE_ENV=development
